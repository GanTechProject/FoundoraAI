# Copy this file to .env only when overriding the documented local defaults.
# Values are intentionally blank. Never commit credentials.

# Host port exposed by the PostgreSQL development container.
POSTGRES_PORT=

# Host port exposed by the Redis development container.
REDIS_PORT=

# Host port exposed by the FastAPI development container.
API_PORT=

# Host port exposed by the Next.js development container.
WEB_PORT=

# Runtime log level (DEBUG, INFO, WARNING, ERROR, or CRITICAL).
FOUNDORA_LOG_LEVEL=

# Browser-visible origin used for CORS, CSRF origin checks, and cookie policy.
FOUNDORA_PUBLIC_ORIGIN=

# Must be true when FOUNDORA_ENVIRONMENT=production; local HTTP development uses false.
FOUNDORA_COOKIE_SECURE=

# Optional Phase 05 provider credentials. Missing values disable that provider.
# Secrets remain server-side and must never use a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Governed model routing and operation limits. Defaults are documented in Phase 05.
FOUNDORA_MODEL_PRIMARY_PROVIDER=
FOUNDORA_MODEL_FALLBACK_PROVIDERS=
FOUNDORA_MODEL_TASK_ROUTES=
FOUNDORA_MODEL_MAX_RETRIES=
FOUNDORA_MODEL_TIMEOUT_SECONDS=
FOUNDORA_MODEL_DEFAULT_MAX_OUTPUT_TOKENS=
FOUNDORA_MODEL_HARD_MAX_OUTPUT_TOKENS=
FOUNDORA_MODEL_DEFAULT_TOKEN_BUDGET=
FOUNDORA_MODEL_DEFAULT_COST_BUDGET_MICROUSD=

# Phase 13 provider-neutral knowledge storage and bounded ingestion settings.
# Local Docker development uses the named volume mounted at this path.
FOUNDORA_KNOWLEDGE_STORAGE_BACKEND=
FOUNDORA_KNOWLEDGE_STORAGE_PATH=
FOUNDORA_KNOWLEDGE_MAX_UPLOAD_BYTES=
FOUNDORA_KNOWLEDGE_MAX_EXTRACTED_CHARACTERS=
